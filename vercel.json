{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "outputDirectory": "preview",
  "cleanUrls": false,
  "rewrites": [
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/public/index.php", "destination": "/public/index.html" },
    { "source": "/public/about.php", "destination": "/public/about.html" },
    { "source": "/public/menu.php", "destination": "/public/menu.html" },
    { "source": "/public/gallery.php", "destination": "/public/gallery.html" },
    { "source": "/public/review.php", "destination": "/public/review.html" },
    { "source": "/public/reservation.php", "destination": "/public/reservation.html" },
    { "source": "/public/contact.php", "destination": "/public/contact.html" },
    { "source": "/public/login.php", "destination": "/public/login.html" },
    { "source": "/public/register.php", "destination": "/public/register.html" },
    { "source": "/public/cart.php", "destination": "/public/cart.html" },
    { "source": "/public/:path*(.*)", "destination": "/404.html" }
  ]
}