# Food Factory — environment template
# Copy to .env for local dev:  cp .env.example .env
# On Render/Vercel, set each variable in the dashboard instead (never commit .env).

APP_NAME=Food Factory
APP_ENV=production
APP_DEBUG=false
# Public base URL, e.g. https://food-factory.onrender.com
APP_URL=https://your-app.example.com

# Database service (managed MySQL/MariaDB "web service")
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=food_factory
DB_USERNAME=food_factory
DB_PASSWORD=change-me

# First-boot admin account (provisioned by deploy/bootstrap.php)
ADMIN_EMAIL=admin@foodfactory.local
ADMIN_PASSWORD=change-me-too

# Optional: PHPMailer / SMTP
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=foodfactory@gmail.com

# Optional: payment gateway
PAYMENT_KEY=
PAYMENT_SECRET=