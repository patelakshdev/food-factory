# Food Factory — environment template
# Copy to .env for local dev:  cp .env.example .env
# On Render/Vercel, set each variable in the dashboard instead (never commit .env).

APP_NAME=Food Factory
APP_ENV=production
APP_DEBUG=false
# Public base URL, e.g. https://food-factory-alpha.vercel.app
APP_URL=https://your-app.example.com

# Database service (managed MySQL/MariaDB "web service", reachable over the
# internet — e.g. Aiven, PlanetScale, Railway, Clever Cloud, your hosting's
# phpMyAdmin/MySQL). Set these as Vercel Environment Variables; never commit
# real credentials.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=food_factory
DB_USERNAME=food_factory
DB_PASSWORD=change-me

# Serverless auto-provisioning: on the first request the app creates the
# schema, seeds data, and ensures the admin below. Set to "false" to disable
# (e.g. when your DB user has no DDL grants and you import the schema manually).
APP_DB_PROVISION=true

# First-boot admin account (provisioned automatically when DB tables are empty)
ADMIN_EMAIL=admin@foodfactory.local
ADMIN_PASSWORD=change-me-too

# Optional: PHPMailer / SMTP
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=foodfactory@gmail.com

# Optional: payment gateway
PAYMENT_KEY=
PAYMENT_SECRET=